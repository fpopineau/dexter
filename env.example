# Dexter day2day configuration — cleaned 2026-07-06.
# Placeholder keys were REMOVED (a placeholder value counts as "key present"
# and breaks provider selection/fallback). Uncomment a line and paste the
# real key to enable that provider. Full option reference: env.example.

# --- LLM providers ---------------------------------------------------------
# ACTION REQUIRED: set at least ONE real LLM key (Anthropic recommended for
# the trading briefs), or pick an Ollama model in the TUI (bun run start).
# All keys ship COMMENTED — an uncommented placeholder counts as "key
# present" and breaks provider selection/fallback.
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GOOGLE_API_KEY=your-google-api-key
# XAI_API_KEY=your-xai-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# MOONSHOT_API_KEY=your-moonshot-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# vLLM (Local LLM — OpenAI-compatible API)
# The model itself is selected via the model picker (vllm/<model-name>).
VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Interactive Brokers (TWS / IB Gateway)
# Port 4002 = IB Gateway paper, 4001 = IB Gateway live,
# 7497 = TWS paper, 7496 = TWS live.
# Always paper-trade first — verify on 4002 before touching 4001.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=0
# Market-data feed type: 1=live, 2=frozen, 3=delayed (~15 min), 4=delayed-frozen.
# RECOMMENDED: 3 — IBKR semantics are live-when-entitled, delayed-fallback
# otherwise, so entitled instruments (US equities on this account) are
# unaffected while unentitled ones (OPTIONS — no OPRA subscription, probe
# 2026-08-13) tick delayed instead of erroring. That is what lets the
# earnings implied-move signal work at evening triage without a paid feed.
# Decision paths are protected: the chase gate and profit trail refuse any
# quote flagged delayed rather than gating on a stale price.
IBKR_MARKET_DATA_TYPE=3
# SAFETY LOCK — order placement is refused on live ports (4001/7496) and on
# non-paper accounts (not starting with 'D') unless this is exactly 'true'.
# Leave false. Only flip it the day you deliberately go live.
IBKR_ALLOW_LIVE=false

# --- Opportunity Engine (continuous scan + ranking, advisory only) ---
# Starts with the gateway when IBKR is configured. Set to false to disable.
OPPORTUNITY_ENGINE=true
# OPP_TOP_N=8            # ranked candidates kept in snapshot and streamed
# OPP_MAX_CANDIDATES=20  # max symbols scored per cycle (IBKR pacing)
# Event triggers: WhatsApp alert when a candidate enters the top 3 above
# this composite score. Debounced per symbol, capped per trading day.
# Live-loop WP1 (2026-09-05, REQ-TRIG-001): bar 75 → 60 and cap 10 → 30 —
# the 4-18% single-name mover class scored 55-66 and never reached an
# evaluation; proposals stamp trigger_rank/trigger_band so the admitted
# 60-74 class is measured apart. Every deterministic gate still applies.
# OPP_TRIGGER_SCORE=60
# OPP_TRIGGER_COOLDOWN_MIN=30
# OPP_TRIGGER_MAX_PER_DAY=30
# Large-cap lane (REQ-SCAN-006): the directional scans run once more with
# a market-cap floor so deep-book names the 3x ETFs crowd off the
# percent-ranked lists get their own rows; admissions take up to
# OPP_LARGECAP_RESERVE reserved candidate slots (best scan rank first).
# OPP_LARGECAP_LANE=true
# OPP_LARGECAP_MIN_USD=10000000000
# OPP_LARGECAP_RESERVE=5
# Deep trigger window (2026-08-11): non-reactors at rank positions 4-10
# are trigger-eligible when they clear OPP_TRIGGER_SCORE + this margin —
# depth costs conviction (ABCL 83 and LINC 84 beat the 75 bar from rank
# 4+ and never fired under top-3-only). 0 = deep window at the base bar;
# negative = old top-3-only behavior. Reactors are unaffected (they keep
# OPP_REACTOR_RELIEF through the whole top 10).
# OPP_DEEP_TRIGGER_MARGIN=5
# Trade execution stays human-only: proposals are executed by replying
# "accept P-XXXX" on WhatsApp or via the approval-gated accept_proposal tool.
# The daily-loss kill-switch (max_daily_loss_pct in risk-rules.yaml) latches
# for the rest of the trading day in .dexter/data/trading-halt.json.
# Auto-execution of proposals (all sources: briefs, scans, triggers).
# On a PAPER account this switch is the whole story. On a LIVE port or
# non-paper account (live-loop WP1, REQ-LIVE-001) every condition must
# also hold: IBKR_ALLOW_LIVE=true, the operator's live switch
# (.dexter/data/live-switch.json — written ON only by the challenge-
# confirmed 'live on <token>' command; 'live off' and every epoch stop
# write OFF — WP4), verified account identity, the 'live' rule
# profile, a running epoch and no latched daily halt. Same gates as
# manual acceptance (kill-switch, risk gate, chase gate) plus its OWN
# daily cap (aligned with max_daily_trades since 2026-09-05)
# and a confidence floor: only proposals with score >=
# AUTO_EXECUTE_MIN_SCORE execute unattended; lower-scored ones stay open
# for a manual 'accept', and UNSCORED proposals never auto-execute at
# any floor. Default 0 (D6, 2026-08-21): the burn-in is an experiment ON
# the score — every gate-passing proposal executes so the ledger samples
# every band; sizing is FLAT (1.0) until the scorer passes calibration.
# (Floor 0 removes the LAST selection stage only — the trigger rank
# threshold, skill floors and the daily cap still shape the sample.)
# Raise the floor only after the score-decile monotonicity gate passes;
# the gateway logs the effective floor at boot.
# AUTO_EXECUTE_PAPER=false
# AUTO_EXECUTE_MAX_PER_DAY=6
# AUTO_EXECUTE_MIN_SCORE=0
# Veto window (REQ-LIVE-002): minutes an announced auto-execution waits
# for 'veto P-XXXX' before placing. 0 (default) = execute immediately;
# the due-sweep (30 s) executes stamped rows through every gate again.
# LIVE_VETO_WINDOW_MIN=0
# Pre-market spread (REQ-RISK-008): a pre-open accept of a DAY entry whose
# pre-market spread is over max_spread_pct but under cap × this multiple
# is DEFERRED to a 09:31 ET re-check (unfilled entry cancelled if the
# regular-session spread still exceeds the cap); beyond it → refused.
# PREMARKET_SPREAD_HARD_MULT=3
# LLM spend cap (REQ-LLM-001/002): evaluation lanes (trigger, breadth,
# mover, cron) refuse to START once today's LLM spend reaches the cap;
# exits, triage and the guardian never call the LLM. A cap > 0 REQUIRES
# both prices (USD per million tokens) or the gateway refuses to boot —
# set LLM_DAILY_SPEND_CAP_USD=0 to disable the cap instead.
# LLM_DAILY_SPEND_CAP_USD=10
# LLM_PRICE_IN_USD_PER_MTOK=
# LLM_PRICE_OUT_USD_PER_MTOK=
# In-process simulator (live-loop WP2, REQ-SIM-001..007): every proposal and
# every refusal with levels gets a shadow twin per variant, settled nightly
# at 17:10 ET into .dexter/data/simulator.db with PESSIMISTIC fills. Not a
# fingerprint surface (observability). Commission assumption: IBKR fixed
# tier, per side max(min, qty × per-share).
# SIMULATOR=true
# SIM_COMMISSION_PER_SHARE_USD=0.005
# SIM_COMMISSION_MIN_USD=1.00
# Live-loop WP3 (REQ-EPOCH-001..004): the nightly looks + digest run as the
# tail of the simulator settle (SIMULATOR must stay on for the nightly
# pipeline). Epoch/ladder/journal lines are appended to
# docs/day2day/VALIDATION-JOURNAL.md; override the journal path if the repo
# docs are not writable from the gateway's working directory.
# DEXTER_JOURNAL_PATH=docs/day2day/VALIDATION-JOURNAL.md
# Chase continuation — DEFAULT OFF since 2026-08-23 ("profit as surely as
# possible": a gate that refused an extended entry should not manufacture
# another way into the same move). When enabled, ONE deterministic STP_LMT
# continuation is created at fresh levels (trigger beyond noise, original
# stop distance, take-policy target, auto-sized, 30-min expiry, every gate
# re-run; never chains). The machinery and its refusal ledger stay.
# CHASE_CONTINUATION=false
# Scorer factor weights: calibrate with scripts/calibrate-scorer.ts --apply
# (writes .dexter/data/scorer-weights.json; equal 0.25 weights otherwise).

# --- Breadth detector (sector-wide melt-ups; default ON with the engine) ---
# When several watchlist mega-caps appear in GAINER scans in one cycle
# (Jul 30: MU/MSFT/AMD/INTC/DELL/TSM/ARM/ASML/SMCI together), the day is a
# regime day: one sector-vehicle evaluation fires (semis-dominated → SOXL,
# else QQQ) OUTSIDE the single-name trigger cap, and the single-name cap
# gets a bonus so later movers still get evaluated.
# OPP_BREADTH_MIN_WATCHED=4     # watchlist movers to declare breadth
# OPP_BREADTH_MAX_PER_DAY=2     # sector-vehicle evaluations per day
# OPP_BREADTH_COOLDOWN_MIN=120  # per-vehicle cooldown
# OPP_BREADTH_CAP_BONUS=5       # extra single-name triggers on breadth days
# OPP_BREADTH_THRESHOLD_RELIEF=10 # watchlist names trigger at (OPP_TRIGGER_SCORE − this) on breadth days
# OPP_BREADTH_VEHICLE_SEMI=SOXL # prefer SMH: a 3x ETF's ATR is 3x by construction, so the noise-stop gate refuses most leveraged-vehicle proposals
# OPP_BREADTH_VEHICLE_BROAD=QQQ

# --- Market regime (deterministic tape classification, 2026-08-18) ---
# Pre/intra-market % moves of QQQ/SPY/SMH/TLT vs the prior close classify the
# tape (risk-off / risk-on / neutral; semis-led; yield-driven). Consumers:
# risk-off RAISES the trigger bar for longs and LOWERS it for shorts
# (defensive tilt — the chased-long loss pattern clusters on down mornings),
# every trigger evaluation gets a TAPE line, and a semis-led risk-off tape
# pre-arms the breadth SHORT-vehicle evaluation before scans accumulate.
# Prices are the signal; headlines stay visibility-only (the GDELT rule).
# REGIME_QQQ_SOLO_PCT=1.2   # QQQ move that alone flips the tag
# REGIME_QQQ_PCT=0.75       # QQQ move that flips it with confirmation
# REGIME_TLT_PCT=0.4        # TLT confirmation move (bonds down = yields up)
# REGIME_SPY_PCT=0.6        # SPY confirmation move
# REGIME_SEMIS_SPREAD_PCT=0.5 # SMH under QQQ by this = semis-led
# REGIME_LONG_PENALTY=10    # long trigger-bar increase on risk-off (0 disables)
# REGIME_SHORT_RELIEF=10    # short trigger-bar decrease on risk-off (0 disables)
# REGIME_PREARM_COOLDOWN_MIN=60 # pre-arm vehicle-evaluation cooldown (scan-driven fires ignore pre-arm stamps)
# REGIME_PREARM_MAX_PER_DAY=2   # tape-only vehicle evaluations per day (separate from OPP_BREADTH_MAX_PER_DAY)

# --- Dawn watch + pre-market mover alerts (MRNA post-mortem, 2026-08-19) ---
# The engine used to idle until 08:00 ET while IBKR scanners work from 04:00 —
# MRNA ran +110% at 06:45-07:50 in that self-imposed blind window. The dawn
# watch runs the pre-open scan set at a slow cadence from OPP_DAWN_START_ET;
# outsized ALIGNED movers fire one deterministic WhatsApp line per symbol per
# day (no LLM, no gates, no orders), and the event-mover boost adds the day
# move itself (capped +25) to compositeRank so a multi-sigma mover can no
# longer rank below an index ETF.
# OPP_DAWN_START_ET=04:00       # dawn-watch start (HH:MM ET); 08:00 restores the old behavior
# OPP_DAWN_CADENCE_MIN=15       # dawn scan cadence (05:00-08:00 needs noticing, not trading rhythm)
# OPP_MOVER_ALERT_PCT=15        # aligned day-move % that fires the pre-market mover alert
# OPP_MOVER_ALERT_RVOL=2        # RVOL floor for the alert when RVOL is known (unknown fails open)
# OPP_EVENT_BOOST_MIN_PCT=10    # aligned day-move % where the compositeRank boost starts

# --- Watchlist sentinel + crypto flavor (COIN/MSTR post-mortem, 2026-08-19) ---
# COIN +10% / MSTR +12% on a BTC rally never cracked a 25-row scan window on a
# biotech-explosion day — watchlist membership granted zero intraday admission.
# The sentinel sweeps watchlist names ABSENT from scans on a slow cadence and
# admits any with an aligned day move past the bar into the normal pipeline
# (scoring, boost, triggers, pre-market alerts), with a guaranteed scoring slot.
# IBIT joins the regime proxies: a big IBIT move DIVERGING from QQQ flags the
# tape crypto-led and pre-arms the crypto vehicle in the IBIT direction.
# OPP_SENTINEL=true             # false disables the sentinel lane
# OPP_SENTINEL_MOVE_PCT=5       # |day move| that admits a watchlist name
# OPP_SENTINEL_CADENCE_MIN=10   # sweep cadence (~60 names, 5-wide chunks)
# OPP_BREADTH_VEHICLE_CRYPTO=IBIT
# REGIME_CRYPTO_PCT=3           # |IBIT| move that makes the tape crypto-led...
# REGIME_CRYPTO_SPREAD_PCT=2    # ...if it diverges from QQQ by at least this

# --- Opportunity Engine market-cap band (optional) ---
# Restrict engine scans to a cap band, e.g. US midcaps. Unset = unchanged
# behavior ($500M floor, no ceiling).
# OPP_MARKET_CAP_MIN=1000000000
# OPP_MARKET_CAP_MAX=5000000000

# --- Universe sweep (nightly midcap directory + daily-bar history; OPT-IN) ---
# Builds a US common-stock universe (nasdaqtrader directory + SEC EDGAR
# shares outstanding, no API key) and archives ~400 days of daily bars for
# names inside the cap band — the substrate for swing/pattern scanners.
# Runs 18:00 ET on trading days when enabled.
# UNIVERSE_SWEEP=false
# UNIVERSE_CAP_MIN=1000000000        # band lower bound (USD)
# UNIVERSE_CAP_MAX=5000000000        # band upper bound (USD)
# UNIVERSE_MAX_REQUESTS=1200         # IBKR historical requests per night
# UNIVERSE_PACE_MS=3000              # pacing between IBKR requests
# UNIVERSE_SEC_BUDGET=2000           # EDGAR requests per night
# UNIVERSE_SEC_UA="dexter-day2day (you@example.com)"  # SEC fair-use User-Agent
# UNIVERSE_EXTRA_SYMBOLS=MU,INTC,NVDA  # watchlist archived + pattern-scanned regardless of the cap band

# --- Profit trail (automatic winner protection; default ON) ---
# During regular hours, positions whose unrealized gain reaches
# profit_trail_arm_pct (risk-rules.yaml, default 5%) are watched against
# their peak; a pullback of profit_trail_pullback_pct (default 1%) closes
# the position at market and cancels its exits. Disable with:
# PROFIT_TRAIL=false

# --- Local dashboard (charts + live book; default ON) ---
# Served by the gateway from dexter's own data — deliberately NOT a second
# IBKR session (external viewers like TradingView's broker integration
# steal the Gateway's session). No auth: keep it on localhost.
# DASHBOARD=true
# Code default is 8484, but Windows' Hyper-V dynamic port exclusions
# (netsh interface ipv4 show excludedportrange protocol=tcp) can swallow
# it after a reboot (EACCES on bind) — the ranges move every boot. This
# deployment pins 8585; pick any port outside the current excluded ranges.
DASHBOARD_PORT=8585
# DASHBOARD_HOST=127.0.0.1

# --- EOD triage (default ON) ---
# 15:52 ET: each filled DAY-bracket position is triaged — closed before
# the bell ONLY if losing vs its entry fill AND still fading over the
# last hour; winners and stabilizing losers keep their overnight chance
# (protected GTC conversion at the bell). Disable with:
# EOD_TRIAGE=false
# Earnings guard: positions whose symbol reports within 1 day are closed
# before the bell REGARDLESS of P&L — a keep must never become an
# accidental earnings bet. Disable with:
# EOD_EARNINGS_GUARD=false

# --- Benchmark & capture ledger (default ON) ---
# 16:45 ET: records the day's top movers (dexter-blind) and how far each
# got through the pipeline (seen/triggered/proposed/refused/executed +
# capture efficiency), replays every gate refusal against the day's bars
# (would the stop or target have hit first?), keeps a per-gate scoreboard,
# appends the day to benchmark-ledger.jsonl and sends a WhatsApp digest.
# The calibration dataset. Disable with:
# BENCHMARK=false

# --- Stale-entry sweeper (default ON, checks every 10 min) ---
# Executed proposals whose ENTRY has not filled after this many days get
# their orders cancelled — frees max_open_positions slots from zombie
# brackets. 0 disables.
# STALE_ENTRY_MAX_DAYS=3
# REQ-ENTRY-001: unfilled INTRADAY entries are also cancelled once the
# proposal's validity window passes, with this many minutes of grace after
# acceptance (a deliberate late accept keeps that much resting time).
# Negative disables the expiry sweep. Swing/earnings-bet entries are
# exempt (patient by design).
# ENTRY_EXPIRY_GRACE_MIN=30

# --- Shadow-live (WP-SHADOW, validation runs the live policy on paper) ---
# 'live' on a PAPER account loads risk-rules.live.yaml (with the single
# documented deviation: earnings bets stay enabled so the class builds its
# record). Pair with the paper account reset to ~$11,700 (~€10K). The
# override can NEVER put a live account on paper rules — ignored loudly.
# DEXTER_RISK_PROFILE=live

# --- Scanner health (engine watchdog) ---
# After this many consecutive ZERO-symbol scan cycles during market hours,
# a degraded-scanner alert is sent to WhatsApp (and a recovery notice when
# scans return). Catches a silently degraded IB Gateway API.
# OPP_HEALTH_EMPTY_CYCLES=3

# --- Event risk (Polymarket, keyless; default ON) ---
# Dated macro binaries (CPI/FOMC/jobs) with market-implied probabilities
# via the event_risk tool, plus per-symbol "beat quarterly earnings?"
# markets as the earnings-bet external signal. The EOD triage report warns
# when overnight keeps ride a macro print resolving today/tomorrow.
# EOD_MACRO_WARNING=true

# --- News pulse (GDELT, keyless; default ON, gateway only) ---
# One batched news sweep every ~20 min (07:00-16:00 ET weekdays) over the
# open book + earnings reactors + engine candidates; surfaced via the
# news_pulse tool and as annotations on the opportunities snapshot.
# Context only — never a scoring input (research memo 2026-08-05).
# NEWS_PULSE=true
# NEWS_PULSE_WINDOW_MIN=180     # lookback per sweep
# NEWS_PULSE_MIN_ARTICLES=4     # unique headlines to flag "hot"
# NEWS_PULSE_MIN_DOMAINS=3      # distinct outlets to flag "hot"
# NEWS_PULSE_MAX_SYMBOLS=24     # symbols per sweep (across all batches)
# NEWS_PULSE_BATCH_SIZE=3       # names per GDELT request — bigger OR
#                               # batches are refused as "larger queries"
#                               # (12 and 24 throttled every time,
#                               # 2026-08-11/12; 1-2 passed from the same
#                               # IP seconds later); requests pace at 6 s
# NEWS_PULSE_BACKOFF_MIN=30     # cool-down after a GDELT throttle response

# --- Data archive (daily post-close bar collection for ML/backtesting) ---
# Runs at 16:20 ET on trading days: archives 1-min and 5-min bars for the
# day's snapshot symbols + proposal symbols + the watchlist below into
# DATA_ARCHIVE_PATH. Set to false to disable.
# DATA_ARCHIVE=true
# DATA_ARCHIVE_SYMBOLS=SPY,QQQ            # always-archived watchlist (comma-separated)
# DATA_ARCHIVE_MAX_SYMBOLS=30             # per-day cap (IBKR pacing)

# --- Paths, logging, backtest data (all optional; defaults shown) ---
# DEXTER_DATA_DIR=.dexter/data            # SQLite store for streamed bars
# DATA_ARCHIVE_PATH=.dexter/data/market-archive.db   # market-data archive DB
# DEXTER_LOG_DIR=.dexter/logs             # JSONL file logs (one file per day)
# DEXTER_LOG_LEVEL=info                   # debug|info|warn|error|off
# DEXTER_LOG_KEEP=14                      # daily log files retained
# FIRSTRATE_DATA_DIR=ActivTradesFX/data/FirstRate/stock   # backtest OHLCV ZIPs
# GDELT_DATA_DIR=GDELT/gdelt_cleaned/parts_monthly        # backtest sentiment parquet

# Persistent memory embeddings reuse existing model API keys.
# Priority: OpenAI (OPENAI_API_KEY) -> Gemini (GOOGLE_API_KEY) -> Ollama (OLLAMA_BASE_URL)
# No additional memory-specific API keys required.

# Stock Market API Key
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# Web Search API Keys (Exa → Perplexity → Tavily → LangSearch)
EXASEARCH_API_KEY=your-exa-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
TAVILY_API_KEY=your-tavily-api-key
LANGSEARCH_API_KEY=your-langsearch-api-key

# X/Twitter API (enables x_search tool for public sentiment research)
X_BEARER_TOKEN=your-X-bearer-token

# LangSmith 
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter
LANGSMITH_TRACING=false

# --- Ops watchdog (scripts/ops/watchdog.ts, handbook §3.2) -------------------
# Independent liveness check: alerts on WhatsApp when the IB Gateway API or
# the dexter gateway process dies. Delivery is via CallMeBot (NOT the
# gateway's own WhatsApp session — that dies with the gateway).
# One-time activation: add +34 644 66 32 62 to your phone contacts, send it
# "I allow callmebot to send me messages" on WhatsApp, paste the returned key.
# WATCHDOG_WHATSAPP_PHONE=+33612345678
# WATCHDOG_CALLMEBOT_APIKEY=your-callmebot-key
# Optional dead-man's switch: a healthchecks.io check URL pinged every round.
# If the whole machine dies, pings stop and healthchecks alerts externally.
# WATCHDOG_HEALTHCHECK_URL=https://hc-ping.com/your-uuid
# Tuning (defaults shown): consecutive fails before the first alert; minutes
# between re-alerts while down; dedicated API client id (never the gateway's).
# WATCHDOG_FAILS_BEFORE_ALERT=2
# WATCHDOG_REALERT_MIN=60
# WATCHDOG_IBKR_CLIENT_ID=87
